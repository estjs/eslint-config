{
  "name": "@estjs/eslint-config",
  "version": "2.3.1",
  "packageManager": "pnpm@11.25.0",
  "description": "",
  "type": "module",
  "keywords": [],
  "license": "MIT",
  "homepage": "https://github.com/estjs/eslint-config#readme",
  "bugs": "https://github.com/estjs/eslint-config/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estjs/eslint-config.git"
  },
  "author": "jiangxd <jiangxd2016@gmail.com>",
  "funding": "https://github.com/sponsors/estjs",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "pnpm run build && eslint --cache --fix ./",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp --commit --tag --push",
    "test": "pnpm run build && vitest",
    "test:watch": "pnpm run build && vitest watch"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "prettier": ">=3"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/compat": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@prettier/plugin-oxc": "^0.2.2",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@unocss/eslint-plugin": "^66.9.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "deepmerge-ts": "^8.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-command": "^4.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.3.3",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-pnpm": "^1.8.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-sort-keys": "^2.3.5",
    "eslint-plugin-unicorn": "^74.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-yml": "^3.8.1",
    "globals": "^17.11.0",
    "jsonc-eslint-parser": "^3.3.0",
    "local-pkg": "^1.2.1",
    "vue-eslint-parser": "^10.4.1",
    "yaml-eslint-parser": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "bumpp": "^12.2.2",
    "eslint": "^10.9.1",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.0",
    "pnpm": "^11.25.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "unocss": "^66.9.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
